{
  "_comment": "MiniMax H3 本地图生视频（FL2VA，首帧 -> 原生音视频联合生成，24fps）。占位符：$PROMPT$ $SEED$ $REF_IMAGE$ $WIDTH$ $HEIGHT$ $LENGTH$ $PREFIX$。帧数 17k+5 网格：107≈4.5s/124≈5.2s/141... 竖屏 768p=768x1344。",
  "10": {
    "inputs": { "image": "$REF_IMAGE$" },
    "class_type": "LoadImage"
  },
  "20": {
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader"
  },
  "21": {
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "class_type": "CLIPLoader"
  },
  "22": {
    "inputs": { "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors" },
    "class_type": "VAELoader"
  },
  "23": {
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" },
    "class_type": "VAELoader"
  },
  "30": {
    "inputs": {
      "clip": ["21", 0],
      "vae": ["22", 0],
      "prompt": "$PROMPT$",
      "width": "$WIDTH$",
      "height": "$HEIGHT$",
      "length": "$LENGTH$",
      "first_frame": ["10", 0]
    },
    "class_type": "MiniMaxH3ImageToVideo"
  },
  "40": {
    "inputs": { "noise_seed": "$SEED$" },
    "class_type": "RandomNoise"
  },
  "41": {
    "inputs": { "sampler_name": "res_multistep" },
    "class_type": "KSamplerSelect"
  },
  "42": {
    "inputs": {
      "model": ["20", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1
    },
    "class_type": "BasicScheduler"
  },
  "43": {
    "inputs": {
      "model": ["20", 0],
      "conditioning": ["30", 0]
    },
    "class_type": "BasicGuider"
  },
  "44": {
    "inputs": {
      "noise": ["40", 0],
      "guider": ["43", 0],
      "sampler": ["41", 0],
      "sigmas": ["42", 0],
      "latent_image": ["30", 1]
    },
    "class_type": "SamplerCustomAdvanced"
  },
  "50": {
    "inputs": {
      "samples": ["44", 0],
      "vae": ["22", 0]
    },
    "class_type": "VAEDecode"
  },
  "51": {
    "inputs": {
      "samples": ["44", 0],
      "vae": ["23", 0]
    },
    "class_type": "VAEDecodeAudio"
  },
  "52": {
    "inputs": {
      "images": ["50", 0],
      "fps": 24,
      "audio": ["51", 0]
    },
    "class_type": "CreateVideo"
  },
  "60": {
    "inputs": {
      "video": ["52", 0],
      "filename_prefix": "$PREFIX$",
      "format": "auto",
      "codec": "auto"
    },
    "class_type": "SaveVideo"
  }
}

  "8": {
    "inputs": { "conditioning": ["5", 0], "latent": ["6", 0] },
    "class_type": "ReferenceLatent",
    "_meta": { "title": "参考Latent（正）" }
  },
  "9": {
    "inputs": { "strength": 1, "pre_cfg": false, "model": ["4", 0] },
    "class_type": "CFGNorm",
    "_meta": { "title": "CFG归一化" }
  },
  "10": {
    "inputs": {
      "seed": "$SEED$",
      "steps": 4,
      "cfg": 1,
      "sampler_name": "euler_ancestral",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["111", 0],
      "positive": ["8", 0],
      "negative": ["7", 0],
      "latent_image": ["6", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "K采样器" }
  },
  "11": {
    "inputs": { "samples": ["10", 0], "vae": ["2", 0] },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE解码" }
  },
  "13": {
    "inputs": { "filename_prefix": "ComfyUI", "images": ["11", 0] },
    "class_type": "SaveImage",
    "_meta": { "title": "保存图像" }
  },
  "14": {
    "inputs": { "image": "$REF_IMAGE$" },
    "class_type": "LoadImage",
    "_meta": { "title": "加载图像（参考/编辑对象）" }
  },
  "15": {
    "inputs": {
      "aspect_ratio": "original",
      "proportional_width": 1,
      "proportional_height": 1,
      "fit": "crop",
      "method": "lanczos",
      "round_to_multiple": "8",
      "scale_to_side": "longest",
      "scale_to_length": 1280,
      "background_color": "#000000",
      "image": ["14", 0]
    },
    "class_type": "LayerUtility: ImageScaleByAspectRatio V2",
    "_meta": { "title": "图层工具：按宽高比缩放 V2" }
  },
  "16": {
    "inputs": { "conditioning": ["5", 0] },
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "条件零化" }
  },
  "107": {
    "inputs": { "anything": ["11", 0] },
    "class_type": "easy cleanGpuUsed",
    "_meta": { "title": "清理显存占用" }
  },
  "110": {
    "inputs": {
      "sage_attention": "auto",
      "allow_compile": false,
      "model": ["1", 0]
    },
    "class_type": "PathchSageAttentionKJ",
    "_meta": { "title": "Patch Sage Attention KJ" }
  },
  "111": {
    "inputs": {
      "reserved": 1,
      "mode": "manual",
      "seed": "$SEED$",
      "auto_max_reserved": 0,
      "clean_gpu_before": true,
      "anything": ["9", 0]
    },
    "class_type": "ReservedVRAMSetter",
    "_meta": { "title": "Set Reserved VRAM(GB) ⚙️" }
  },
  "112": {
    "inputs": {
      "offload_model": true,
      "offload_cache": true,
      "anything": ["3", 0]
    },
    "class_type": "VRAMCleanup",
    "_meta": { "title": "🎈VRAM-Cleanup" }
  }

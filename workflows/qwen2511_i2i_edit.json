      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "加载CLIP" }
  },
  "4": {
    "inputs": {
      "lora_name": "Qwen2511\\Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors",
      "strength_model": 1,
      "model": ["110", 0]
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "LoRA加载器（仅模型）" }
  },
  "5": {
    "inputs": {
      "prompt": "$PROMPT$",
      "clip": ["112", 0],
      "image1": ["15", 0]
    },
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "文本编码 Qwen Image 编辑 Plus" }
  },
  "6": {
    "inputs": { "pixels": ["15", 0], "vae": ["2", 0] },
    "class_type": "VAEEncode",
